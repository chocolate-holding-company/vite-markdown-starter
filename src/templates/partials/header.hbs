<header
 style="background-image: url({{image}});"
 class="bg-slate-900 text-white p-4 shadow-md"
>

 <nav class="max-w-3xl mx-auto flex gap-4">
  <a
   href="/"
   {{#if activeHome}}aria-current="page"{{/if}}
   class="text-blue-300 hover:text-blue-500 aria-[current=page]:text-red-600 aria-[current=page]:font-semibold"
  >Home</a>
  <a
   href="/about/"
   {{#if activeAbout}}aria-current="page"{{/if}}
   class="text-blue-300 hover:text-blue-500 aria-[current=page]:text-red-600 aria-[current=page]:font-semibold"
  >About</a>
  <a
   href="/hello/"
   {{#if activeHello}}aria-current="page"{{/if}}
   class="text-blue-300 hover:text-blue-500 aria-[current=page]:text-red-600 aria-[current=page]:font-semibold"
  >Hello</a>
  <a
   href="/goodbye/"
   {{#if activeGoodbye}}aria-current="page"{{/if}}
   class="text-blue-300 hover:text-blue-500 aria-[current=page]:text-red-600 aria-[current=page]:font-semibold"
  >Goodbye</a>
 </nav>
</header>