{{!-- change starter.org and Starter to your site, change yourname --}}
<meta charset="utf-8" />
<meta
   name="viewport"
   content="width=device-width, initial-scale=1, shrink-to-fit=no"
  />

<title>{{title}} | Starter</title>
<meta name="description" content="{{description}}" />
<link rel="canonical" href="https://starter.org{{link}}" />

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content="Starter" />
<meta property="og:type" content="website" />
<meta property="og:title" content="{{title}} | Starter" />
<meta property="og:description" content="{{description}}" />
<meta property="og:url" content="https://starter.org{{link}}" />
<meta property="og:image" content="https://starter.org{{image}}" />
<meta property="og:image:alt" content="{{title}} header image" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{title}} | starter" />
<meta name="twitter:description" content="{{description}}" />
<meta name="twitter:image" content="https://starter.org{{image}}" />

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "{{title}}",
    "description": "{{description}}",
    "image": "https://starter.org{{image}}",
    "datePublished": "2026-02-15T08:00:00+08:00",
    "author": {
      "@type": "Person",
      "name": "yourname",
      "url": "https://starter.org/about"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Starter",
      "logo": {
        "@type": "ImageObject",
        "url": "https://starter.org/logo.jpg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://starter.org{{link}}"
    }
  }
</script>

<!-- Icons and Theme -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#4A6741" />